{
  "title": "개발자 통합 가이드",
  "descriptionPart1": "이 단계별 자습서를 따라 애플리케이션을 다음 서비스와 통합하세요:",
  "descriptionPart2": "안전한 인증을 위해 PKCE가 포함된 업계 표준 OAuth 2.0 권한 부여 코드 흐름을 지원합니다.",
  "steps": {
    "step1": {
      "title": "애플리케이션 등록",
      "description": "클라이언트 자격 증명 얻기",
      "content": {
        "intro": "ID 공급자와의 통신을 시작하려면 애플리케이션을 등록해야 합니다.",
        "list": {
          "0": "계정에 로그인합니다.",
          "1": {
            "part1": "다음으로 이동합니다: 프로필 대시보드 >",
            "bold": "개발자 애플리케이션"
          },
          "2": {
            "part1": "다음을 클릭합니다:",
            "bold": "새 애플리케이션 등록"
          },
          "3": {
            "part1": "세부 정보를 입력하고 다음을 저장합니다:",
            "code1": "Client ID",
            "part2": "및",
            "code2": "Client Secret"
          }
        }
      }
    },
    "step2": {
      "title": "리디렉션 URI 구성",
      "description": "인증 흐름 보안",
      "content": {
        "intro": "ID 공급자는 명시적으로 승인한 URL로만 사용자를 리디렉션합니다. 이렇게 하면 오픈 리디렉션 공격을 방지할 수 있습니다.",
        "list": {
          "0": "애플리케이션 설정으로 이동합니다.",
          "1": {
            "part1": "다음 아래에 콜백 URL을 추가합니다:",
            "bold": "승인된 리디렉션 URI"
          },
          "2": {
            "part1": "로컬 개발의 경우 다음을 사용할 수 있습니다:",
            "code": "http://localhost:3000/..."
          }
        }
      }
    },
    "step3": {
      "title": "권한 부여 흐름 구현",
      "description": "권한 부여를 위해 리디렉션",
      "content": {
        "intro": "사용자를 권한 부여 엔드포인트로 리디렉션합니다. PKCE code_challenge를 생성해야 합니다."
      }
    },
    "step4": {
      "title": "토큰으로 코드 교환",
      "description": "콜백 처리",
      "content": {
        "intro": {
          "part1": "사용자가 인증되면 다음과 함께 앱으로 리디렉션됩니다.",
          "code": "code",
          "part2": "이를 액세스 토큰으로 교환합니다."
        }
      }
    },
    "step5": {
      "title": "사용자 프로필 가져오기",
      "description": "액세스 토큰 사용",
      "content": {
        "intro": {
          "part1": "이제",
          "code": "access_token",
          "part2": "을(를) 얻었으므로 이를 사용하여 /api/sso/v1/userinfo 엔드포인트에서 사용자 프로필을 가져옵니다."
        }
      }
    },
    "step6": {
      "title": "토큰 새로 고침 처리",
      "description": "오프라인 액세스 유지",
      "content": {
        "intro": {
          "part1": "액세스 토큰이 만료되면 사용자가 다시 로그인하지 않아도 되도록",
          "code": "refresh_token",
          "part2": "을(를) 사용하여 새 액세스 토큰을 요청합니다."
        }
      }
    }
  }
}
