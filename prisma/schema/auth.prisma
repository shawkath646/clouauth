model PasswordCredential {
  user_id         String    @id
  password_hash   String
  last_changed_on DateTime  @default(now())
  force_change    Boolean   @default(false)
  failed_attempts Int       @default(0)
  locked_until    DateTime?
  user            User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model PasswordHistory {
  id            String   @id @default(cuid())
  user_id       String
  password_hash String
  created_on    DateTime @default(now())
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model RecoveryCode {
  id         String    @id @default(cuid())
  user_id    String
  code_hash  String
  used       Boolean   @default(false)
  created_on DateTime  @default(now())
  used_on    DateTime?
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model TwoFactor {
  user_id String @id

  passkeys PasskeyCredential[]
  totp     TotpMethod?

  email_id String?    @unique
  email    UserEmail? @relation(fields: [email_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  phone_id String?    @unique
  phone    UserPhone? @relation(fields: [phone_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model PasskeyCredential {
  id String @id @default(cuid())

  two_factor_id String

  credential_id String @unique
  public_key    String @db.Text
  sign_count    Int    @default(0)

  device_name  String?
  created_on   DateTime  @default(now())
  last_used_on DateTime?

  two_factor TwoFactor @relation(fields: [two_factor_id], references: [user_id], onDelete: Cascade)
}

model TotpMethod {
  id String @id @default(cuid())

  two_factor_id String @unique

  enabled Boolean @default(false)

  secret    String
  algorithm String
  digits    Int
  period    Int

  two_factor TwoFactor @relation(fields: [two_factor_id], references: [user_id], onDelete: Cascade)
}

model OAuthAccount {
  id               String   @id @default(cuid())
  user_id          String
  provider         String
  provider_user_id String
  access_token     String?  @db.Text
  refresh_token    String?  @db.Text
  expires_at       Int?
  created_on       DateTime @default(now())
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
}

model SigningKey {
  id String @id @default(cuid())

  kid String @unique

  kty String
  alg String
  use String @default("sig")

  publicKey  String @db.Text
  privateKey String @db.Text

  jwk String @db.NVarChar(Max)

  active Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?
  revokedAt DateTime?
}
